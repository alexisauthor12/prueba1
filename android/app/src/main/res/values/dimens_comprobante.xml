<?xml version="1.0" encoding="utf-8"?>
<!--
  Comprobante de operación (se abre al pulsar Pagar en PagomovilBDV).
  Medidas exactas del mockup design/referencia-comprobante.jpeg
  (633x1280 px -> lienzo de diseno 360 x 727.9 dp):

      dp = px / 1.75833     (633 px = 360 dp)

  Los margenes superiores de los textos descuentan el hueco entre el borde de
  la caja y la altura de mayuscula, que con Nunito (la fuente de marca: ascenso
  1.011 em y capHeight 0.715 em, medidos con tools/medir-metricas.ps1) es de
  0.296 em. Con Arimo era 0.216 em, asi que al cambiar de fuente todos los
  margenes bajan 0.081 em para que la tinta caiga en el mismo pixel.
-->
<resources>

    <!-- ===== Barra superior ===== -->
    <dimen name="cp_flecha">18.2dp</dimen>
    <dimen name="cp_flecha_margin_izq">18.8dp</dimen>
    <dimen name="cp_flecha_margin_top">20.5dp</dimen>

    <dimen name="cp_titulo_texto">16sp</dimen>
    <dimen name="cp_titulo_margin_top">18dp</dimen>
    <!-- El mockup lleva el titulo 8,5 px (4.83 dp) a la izquierda del centro:
         su tinta va de x 126 a x 490 en un lienzo de 633 px, con margenes 126 y
         143. Se reproduce con una translationX. -->
    <dimen name="cp_titulo_desplazamiento">-4.8dp</dimen>

    <dimen name="cp_compartir_ancho">21.6dp</dimen>
    <dimen name="cp_compartir_alto">22.7dp</dimen>
    <dimen name="cp_compartir_margin_izq">325.3dp</dimen>
    <dimen name="cp_compartir_margin_top">17.6dp</dimen>

    <!-- ===== Centro: logo, subtitulo y check ===== -->
    <dimen name="cp_logo_ancho">51.2dp</dimen>
    <dimen name="cp_logo_alto">54.6dp</dimen>
    <dimen name="cp_logo_margin_izq">153dp</dimen>
    <dimen name="cp_logo_margin_top">83.6dp</dimen>

    <dimen name="cp_subtitulo_texto">14sp</dimen>
    <dimen name="cp_subtitulo_margin_top">142.5dp</dimen>

    <dimen name="cp_check_ancho">28.4dp</dimen>
    <dimen name="cp_check_alto">27.9dp</dimen>
    <dimen name="cp_check_margin_izq">165.5dp</dimen>
    <dimen name="cp_check_margin_top">168.3dp</dimen>

    <!-- ===== Caja del monto: 543x69 px (308.8x39.2 dp), radio 9.7 dp ===== -->
    <dimen name="cp_caja_ancho">308.8dp</dimen>
    <dimen name="cp_caja_alto">39.2dp</dimen>
    <dimen name="cp_caja_margin_izq">25.6dp</dimen>
    <dimen name="cp_caja_margin_top">207.6dp</dimen>
    <dimen name="cp_caja_radio">9.7dp</dimen>

    <!-- Monto: Nunito 500. Medido, el mockup lleva el monto con trazos de
         3,93 px de media; Nunito 400 da 3,6 y el 500 clava los 3,93 px con el
         ancho exacto del mockup (132 px). Con Arimo la diferencia de esta zona
         era 13,4 y con Nunito baja a 5,8: es el texto que mas gana. -->
    <dimen name="cp_monto_texto">14.2sp</dimen>
    <dimen name="cp_monto_margin_top">217dp</dimen>

    <!-- ===== Filas: etiqueta a 32.4 dp, valor a 33 dp del borde =====
         El valor de "Operacion:" es el unico que no llega al borde: termina en
         x 540 (52.9 dp) porque a su lado va el icono de copiar (555..582). -->
    <dimen name="cp_fila_texto">12.5sp</dimen>
    <dimen name="cp_etiqueta_margin_izq">32.4dp</dimen>
    <dimen name="cp_valor_margin_der">33dp</dimen>
    <dimen name="cp_valor2_margin_der">52.9dp</dimen>
    <dimen name="cp_fila1_margin_top">261.3dp</dimen>
    <dimen name="cp_fila2_margin_top">289.2dp</dimen>
    <dimen name="cp_fila3_margin_top">317.6dp</dimen>
    <dimen name="cp_fila4_margin_top">346.1dp</dimen>
    <dimen name="cp_fila5_margin_top">373.9dp</dimen>
    <dimen name="cp_fila6_margin_top">401.8dp</dimen>
    <dimen name="cp_fila7_margin_top">430.2dp</dimen>

    <!-- Icono de copiar: 28x34 px en (555, 508), al lado del numero (que
         termina en x 540), no encima. -->
    <dimen name="cp_copiar_ancho">15.9dp</dimen>
    <dimen name="cp_copiar_alto">19.3dp</dimen>
    <dimen name="cp_copiar_margin_izq">315.6dp</dimen>
    <dimen name="cp_copiar_margin_top">288.9dp</dimen>

    <!-- ===== Pie: flecha, separador y los dos interruptores ===== -->
    <dimen name="cp_flecha_pie_ancho">22.7dp</dimen>
    <dimen name="cp_flecha_pie_alto">22.2dp</dimen>
    <dimen name="cp_flecha_pie_margin_izq">168.3dp</dimen>
    <dimen name="cp_flecha_pie_margin_top">580.7dp</dimen>

    <dimen name="cp_separador_alto">3.4dp</dimen>
    <dimen name="cp_separador_margin_top">623.3dp</dimen>

    <dimen name="cp_track_ancho">35.8dp</dimen>
    <dimen name="cp_track_alto">19.9dp</dimen>
    <dimen name="cp_track_radio">10dp</dimen>
    <dimen name="cp_track_margin_izq">105.8dp</dimen>
    <dimen name="cp_track1_margin_top">646dp</dimen>
    <dimen name="cp_track2_margin_top">693.8dp</dimen>

    <dimen name="cp_knob">18.2dp</dimen>
    <dimen name="cp_knob_radio">9.1dp</dimen>
    <dimen name="cp_knob_margin_izq">106.3dp</dimen>
    <dimen name="cp_knob1_margin_top">646.9dp</dimen>
    <dimen name="cp_knob2_margin_top">694.7dp</dimen>

    <dimen name="cp_int_texto">12sp</dimen>
    <dimen name="cp_int_margin_izq">155.3dp</dimen>
    <dimen name="cp_int1_margin_top">647.6dp</dimen>
    <dimen name="cp_int2_margin_top">695.9dp</dimen>

</resources>
