<?xml version="1.0" encoding="utf-8"?>
<!--
  Nunito en peso 600: el monto del comprobante y el subtitulo "PagomovilBDV
  Personas". El mockup es un JPEG y el desenfoque engorda la letra, asi que hay
  que subir el peso para que se vea igual de marcada: el monto se quedo en 600
  (el 650 costaba el doble de diferencia) y el subtitulo tambien, que a 400 y a
  500 se veia mas fino que la referencia.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/nunito_variable"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600" />
</font-family>
