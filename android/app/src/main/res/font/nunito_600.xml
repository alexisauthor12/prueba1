<?xml version="1.0" encoding="utf-8"?>
<!--
  Nunito en peso 600: el monto del comprobante. El mockup es un JPEG y el
  desenfoque engorda la letra, asi que con el 500 el monto se veia "menos
  marcado" que la referencia en el movil. Medido con renders de verdad, el 600
  con el mismo blanco suave cuesta solo 0,13 de diferencia en la zona
  (5,77 -> 5,90); el 650 sube a 7,04.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/nunito_variable"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600" />
</font-family>
